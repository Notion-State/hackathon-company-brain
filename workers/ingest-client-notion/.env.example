# Per-client Notion integration credentials. Add a `_<ID>` pair for each
# client whose Feature Requests database you want to mirror. `<ID>` is a
# lowercase slug (e.g. `ACME` in the env name → `acme` as the client id).
#
# Both values per client are required. Setting one without the other will
# throw at module-init, by design — silently skipping a half-configured
# client hides bad onboarding.
#
# CLIENT_NOTION_TOKEN_ACME=secret_xxx
# CLIENT_NOTION_DB_ID_ACME=00000000-0000-0000-0000-000000000000

# How far back to seed a brand-new client's delta cursor on first run.
# Ignored by the backfill (which is always a full sweep). Clamped to [1, 3650].
CLIENT_NOTION_BACKFILL_DAYS=30
