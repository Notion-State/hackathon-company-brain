# Per-client Notion internal-integration token. The `<ID>` suffix is uppercase
# in the env-var name; the parsed client id is its lowercase form (e.g. ACME → "acme").
# Required for every configured client.
# Create the integration at: https://www.notion.so/profile/integrations/internal
# Capabilities to grant: Read content, Update content, Insert content,
# plus "Read user information including email addresses" (needed for the
# Presenter person property on Status Updates — we resolve emails to Notion
# users via users.list).
# CLIENT_TOKEN_ACME=

# Per-client destination database ids — one per Transformation Hub doc type.
# Each DB is cloned by the client from the canonical Transformation Hub
# template (https://www.notion.so/d931147211b445d9b62b0fd66cf5ff2b) and
# augmented with a single rich_text `Brain ID` property we use for
# idempotency. All three are required per client.
# CLIENT_DOCS_DB_ACME=
# CLIENT_STATUS_UPDATES_DB_ACME=
# CLIENT_DELIVERABLES_DB_ACME=

# Per-client mode. "staging" (default) or "production". A production-mode push
# additionally requires `allowProduction: true` on the tool call.
# CLIENT_MODE_ACME=staging
