# Per-client Notion internal-integration token. The `<ID>` suffix is uppercase
# in the env-var name; the parsed client id is its lowercase form (e.g. ACME → "acme").
# Required for every configured client.
# Create the integration at: https://www.notion.so/profile/integrations/internal
# Capabilities to grant: Read content, Update content, Insert content,
# plus "Read user information including email addresses" (needed for the
# Presenter person property on Status Updates — we resolve emails to Notion
# users via users.list).
# CLIENT_TOKEN_ACME=

# Per-client destination database ids — one per Transformation Hub doc type.
# Each DB is cloned by the client from the canonical Transformation Hub
# template (https://www.notion.so/d931147211b445d9b62b0fd66cf5ff2b) and
# augmented with a single rich_text `Brain ID` property we use for
# idempotency. All three are required per client.
# CLIENT_DOCS_DB_ACME=
# CLIENT_STATUS_UPDATES_DB_ACME=
# CLIENT_DELIVERABLES_DB_ACME=

# Per-client mode. "staging" (default) or "production". A production-mode push
# additionally requires `allowProduction: true` on the tool call.
# CLIENT_MODE_ACME=staging

# Optional friendly name used in the AI Drafts `Location` markdown link text
# (defaults to the client id when unset). Example: "Aduro Advisors".
# CLIENT_DISPLAY_NAME_ACME=

# Maps the draft's `Company` relation page id → this client id. Required for
# every client that should be reachable via "Send to Client OS". Use the page
# id (with or without dashes) from the company's Notion URL.
# COMPANY_PAGE_ACME=

# ---- Reserved "notion-state" client (home workspace) ----
# Used by the AI Drafts dispatcher to publish into our own workspace's three
# Transformation Hub destinations. Same env shape as a real client; the
# reserved id is the literal lowercase string "notion-state".
# CLIENT_TOKEN_NOTIONSTATE=
# CLIENT_DOCS_DB_NOTIONSTATE=
# CLIENT_STATUS_UPDATES_DB_NOTIONSTATE=
# CLIENT_DELIVERABLES_DB_NOTIONSTATE=
# CLIENT_MODE_NOTIONSTATE=staging
# NS_OS_DISPLAY_NAME=Notion State OS

# ---- AI Drafts dispatcher (Artifact Categories registry) ----
# Data source id of the Artifact Categories registry inside our workspace.
# The dispatcher reads it once at first use to map a draft's Artifact
# Category relation page id to a canonical category name (Doc / Status
# Update / Deliverable / Feature Requests).
# DRAFTS_REGISTRY_ARTIFACT_CATEGORIES_DS=6d03178d-90aa-47cf-912a-459e1ff7983d
