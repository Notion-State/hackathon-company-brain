# Fireflies.AI default account API key.
# Get from: https://app.fireflies.ai/integrations/custom/fireflies
FIREFLIES_API_KEY=

# Backfill window in days. Used by firefliesBackfill and by the first run of
# firefliesDelta (before a cursor has been persisted). Clamped to [1, 3650].
FIREFLIES_BACKFILL_DAYS=30

# Multi-account ingest (optional). Set one or more of these to sync from
# additional Fireflies workspaces. The suffix (lowercased) becomes the
# account id stored in the `Account` property of each row.
# FIREFLIES_API_KEY_ACME=
# FIREFLIES_API_KEY_BETA=
