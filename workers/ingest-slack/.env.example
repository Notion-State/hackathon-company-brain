# Slack bot token (xoxb-...). Required.
# Create / install your Slack app at https://api.slack.com/apps and copy the
# bot token from "OAuth & Permissions". Required scopes (bot):
#   channels:read, channels:history, channels:join, users:read,
#   users:read.email, team:read
# See README.md for the full setup walk-through.
SLACK_BOT_TOKEN=

# Backfill window in days. Used by `slackBackfill` and by the first run of
# `slackDelta` (before a per-channel cursor has been persisted). Clamped to
# [1, 3650]. Threads whose parent message is older than this window are NOT
# pulled, even if they had recent replies — increase if you need a longer
# history.
SLACK_BACKFILL_DAYS=30
