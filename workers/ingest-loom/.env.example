# Internal integration token used to read the source Notion database. Required.
# Create at https://www.notion.so/profile/integrations/internal, then share
# the source database (see LOOM_SOURCE_DATABASE_ID below) with this
# integration. See README.md for full setup walk-through.
NOTION_API_TOKEN=

# Source database id (the Notion database whose rows contain Loom URLs).
# Required. Defaults to the production source DB the worker was built for.
LOOM_SOURCE_DATABASE_ID=c148c2e3aa554651bd9ca44b1de751d0

# Name of the URL property on each source row that holds the Loom share link.
# Required. Override if pointing at a clone of the source DB with a different
# column name.
LOOM_SOURCE_URL_PROPERTY=Video URL

# Kill switch for Loom's undocumented public GraphQL endpoint (owner info,
# view/comment counts, transcripts). Set to "false" if Loom changes their
# schema and the GraphQL path starts failing — Core metadata (title,
# thumbnail, duration, description, upload date) will still populate.
# Defaults to enabled.
LOOM_ENABLE_GRAPHQL=true
